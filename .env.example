# Optional: Edison enables paid FutureHouse platform agents and data analysis.
# Leave unset to use Robin's open literature fallback for literature research.
# EDISON_API_KEY=your_edison_api_key_here

# Literature backend: auto uses Edison when EDISON_API_KEY is real, otherwise open.
ROBIN_LITERATURE_BACKEND=auto

# Optional but recommended for polite scholarly APIs.
# ROBIN_LITERATURE_EMAIL=you@example.com

# Optional free API keys for higher open-literature rate limits.
# SEMANTIC_SCHOLAR_API_KEY=
# OPENALEX_API_KEY=

# Optional: provide a SearXNG /search endpoint to OpenCode-backed agents.
# ROBIN_WEB_SEARCH_URL=http://127.0.0.1:8080/search

# Optional: override the local Docker Compose SearXNG secret.
# SEARXNG_SECRET=replace_with_a_random_local_secret
